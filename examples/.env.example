# Copy this file to examples/.env and replace every value.
# Never commit real credentials.
GOWA_BASE_URL=https://gowa.example.com
GOWA_USERNAME=admin
GOWA_PASSWORD=replace-with-a-secret
GOWA_DEVICE_ID=existing-device-id

# Required only by send-text.php. Use a test recipient that has consented.
GOWA_RECIPIENT=5511999999999
GOWA_TEST_MESSAGE=Integration test sent by gowa-php
# Explicitly opt in before a real message can be sent.
GOWA_SEND_MESSAGE=0
