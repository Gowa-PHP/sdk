{
    "name": "aguinaldotupy/gowa-php",
    "description": "Pure PHP SDK for the go-whatsapp-web-multidevice (GOWA) server",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Aguinaldo Tupy",
            "email": "aguinaldo.tupy@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-hash": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "pestphp/pest": "^2.34 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Gowa\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gowa\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/pest"
    }
}
